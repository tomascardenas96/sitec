---
import { allProjects } from "../../data/projects.js";
import ProjectCard from "../common/Project-card.astro";
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";

// Las 3 fotos reales del catálogo (ver DESIGN-SYSTEM.md §5): son las mismas
// que ya usa la home, presentadas acá como la entrada al registro completo.
const featured = allProjects.slice(0, 3);
---

<section class="py-20 lg:py-28 2xl:py-32">
    <Container>
        <SectionTitle
            kicker="Obras destacadas"
            label="Lo que sale del taller"
            align="start"
            class="lg:max-w-[42rem]"
        />

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 2xl:gap-8">
            {
                featured.map((project, index) => (
                    <ProjectCard
                        image={project.image}
                        title={project.title}
                        subtitle={project.subtitle}
                        id={project.id}
                        index={index}
                    />
                ))
            }
        </div>
    </Container>
</section>
