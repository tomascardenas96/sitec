---
interface Props {
    variant?:
        | "primary"
        | "solidDark"
        | "outline"
        | "outlineLight"
        | "ghost"
        | "floating";
    size?: "sm" | "md" | "lg";
    href?: string;
    target?: string;
    rel?: string;
    type?: "button" | "submit";
    fullWidth?: boolean;
    label?: string;
    class?: string;
}

const {
    variant = "outline",
    size = "md",
    href,
    target,
    rel,
    type,
    fullWidth = false,
    label,
    class: className = "",
} = Astro.props;

const sizeClasses: Record<string, string> = {
    sm: "h-9 px-5 text-xs",
    md: "h-12 px-7 text-sm",
    lg: "h-14 px-9 text-base",
};

// Cantos vivos y bloques macizos: la pieza se comporta como chapa, no como pastilla.
const variantClasses: Record<string, string> = {
    primary:
        "bg-accent-500 text-white hover:bg-accent-400 active:bg-accent-600 hover:-translate-y-[2px] active:translate-y-0",
    solidDark:
        "bg-steel-950 text-white hover:bg-steel-800 hover:-translate-y-[2px] active:translate-y-0",
    outline:
        "border-2 border-steel-900 text-steel-900 hover:bg-steel-900 hover:text-white",
    outlineLight:
        "border-2 border-white/60 text-white hover:text-black/60 hover:bg-white hover:text-steel-950 hover:border-white",
    ghost: "text-primary-500 hover:text-accent-700 underline-offset-[6px] hover:underline px-0",
    floating:
        "bg-success text-steel-950 size-14 hover:bg-success-600 hover:-translate-y-[2px]",
};

const base =
    "group font-oswald uppercase tracking-[0.14em] font-medium inline-flex items-center justify-center gap-2.5 cursor-pointer no-underline hover:no-underline transition-all duration-200 ease-out";

const width = fullWidth ? "w-full" : "";
const sized =
    variant === "floating" || variant === "ghost" ? "" : sizeClasses[size];
const Tag = href ? "a" : "button";
const autoRel = target === "_blank" ? (rel ?? "noopener noreferrer") : rel;
---

<Tag
    href={href}
    target={target}
    rel={autoRel}
    type={href ? undefined : (type ?? "button")}
    aria-label={label}
    class={`${base} ${variantClasses[variant]} ${sized} ${width} ${className}`.trim()}
>
    <slot />
</Tag>
