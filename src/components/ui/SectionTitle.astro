---
interface Props {
    label: string;
    kicker?: string;
    subtitle?: string;
    variant?: "default" | "inverse";
    align?: "center" | "start";
    hasIcon?: boolean;
    class?: string;
}

const {
    label,
    kicker,
    subtitle,
    variant = "default",
    align = "center",
    hasIcon = false,
    class: className = "",
} = Astro.props;

const inverse = variant === "inverse";

const titleColor = inverse ? "text-white" : "text-steel-900";
const subtitleColor = inverse ? "text-steel-200" : "text-steel-500";
const kickerColor = inverse ? "text-accent-400" : "text-accent-700";
const iconColor = inverse ? "text-accent-400" : "text-primary-500";

const alignment =
    align === "start" ? "items-start text-left" : "items-center text-center";
---

<div class={`flex flex-col ${alignment} ${className}`.trim()}>
    <!-- Marcador de sección: barra de señalización + rótulo grabado. -->
    <div class="mb-6 flex items-center gap-3">
        <span
            class="h-[3px] w-10 bg-accent-500 origin-left"
            data-reveal="expand-x"
            data-origin="left"></span>
        {
            hasIcon && (
                <span class={`w-5 h-5 ${iconColor}`}>
                    <slot name="icon" />
                </span>
            )
        }
        {
            kicker && (
                <span class={`plate text-2xs ${kickerColor}`}>{kicker}</span>
            )
        }
    </div>

    <h2
        class={`font-oswald uppercase font-medium tracking-display text-4xl lg:text-5xl 2xl:text-6xl ${titleColor}`}
        data-reveal="fade-up"
    >
        {label}
    </h2>

    {
        subtitle && (
            <p
                class={`mt-4 text-base lg:text-lg leading-relaxed max-w-measure ${subtitleColor}`}
                data-reveal="fade-up"
                data-reveal-delay="80"
            >
                {subtitle}
            </p>
        )
    }
</div>
