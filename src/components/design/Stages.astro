---
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import ProcessRow from "../common/Process-row.astro";
import { longFlow } from "../../data/design-flow.js";
---

<!-- Es el pago de la promesa de la home: Design-section.astro linkea acá con
     "Ver el proceso completo". Acá va la taxonomía larga (5 etapas), no las
     4 líneas de servicio de shortFlow. -->
<section class="bg-steel-900 py-20 lg:py-28 2xl:py-32">
    <Container>
        <SectionTitle
            label="Las cinco etapas de un proyecto"
            kicker="Cómo trabajamos"
            subtitle="Todo tablero recorre las mismas etapas, desde el análisis inicial hasta el soporte post-venta."
            variant="inverse"
            align="start"
            class="lg:max-w-[48rem]"
        />

        <ol role="list" class="mt-10 border-t border-white/15 lg:mt-12">
            {
                longFlow.map((item, index) => (
                    <ProcessRow
                        step={String(index + 1).padStart(2, "0")}
                        title={item.title}
                        description={item.subtitle}
                        deliverable={item.deliverable}
                        index={index}
                    />
                ))
            }
        </ol>
    </Container>
</section>
