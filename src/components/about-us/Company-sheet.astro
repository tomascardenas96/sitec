---
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";

// Copy compuesto a partir de material que ya existe en el sitio (About-section.astro,
// Hero.astro, faqs.js, design-flow.js). No inventa alcance nuevo; conviene que lo
// valide alguien de la empresa antes de publicar. El primer párrafo evita repetir la
// bajada de Title-page (misma pantalla, un scroll más abajo): ahí ya dice "diseño,
// fabricación y montaje"; acá el foco es la trayectoria y a quién atiende.
const paragraphs = [
    "Más de 15 años de trayectoria en la industria eléctrica, brindando soluciones a industrias, comercios, obras y proyectos particulares.",
    "El trabajo entra por la ingeniería y sale por la puesta en marcha: estudiamos el requerimiento, definimos componentes y protecciones, armamos y cableamos el tablero, lo montamos en obra y lo dejamos funcionando. También fabricamos a partir de planos y especificaciones del cliente.",
    "Todo se construye bajo normas IRAM e IEC 61439, con componentes de primeras marcas y controles en cada etapa. Después de la entrega seguimos disponibles: mantenimiento preventivo y correctivo, y asistencia técnica post-venta.",
];

// Ficha de empresa: solo datos que ya existen en el sitio (Hero.astro, Main-layout.astro,
// About-section.astro, faqs.js). Cero dato inventado.
const sheet = [
    {
        label: "Actividad",
        value: "Tableros eléctricos y montajes electromecánicos",
    },
    { label: "Base de operaciones", value: "Tandil, Buenos Aires" },
    { label: "Experiencia", value: "+15 años" },
    { label: "Normas de fabricación", value: "IRAM · IEC 61439" },
    { label: "Alcance del servicio", value: "Diseño → Puesta en marcha" },
    { label: "Clientes", value: "Industria, comercio, obra y particulares" },
];
---

<section class="py-20 lg:py-28 2xl:py-32">
    <Container>
        <SectionTitle
            kicker="Quiénes somos"
            label="Más de 15 años en el tablero"
            align="start"
            class="lg:max-w-[42rem]"
        />

        <!-- La ficha va primero, pegada al título: es la promesa de la página (la chapa
         de datos del hero, a ancho completo), no una nota al pie del texto. Cada
         celda cita esa chapa — valor grande arriba, rótulo grabado abajo — con
         steel-400 en vez de accent-400 porque a text-2xs el naranja no pasa AA
         sobre blanco (ver DESIGN-SYSTEM.md §1.1). -->
        <dl
            class="mt-10 grid border-t border-steel-200 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3"
            data-reveal="fade-up"
            data-reveal-delay="60"
        >
            {
                sheet.map((item, index) => (
                    <div
                        class:list={[
                            "flex flex-col-reverse gap-1.5 border-b border-steel-200 py-6",
                            index % 2 === 1 && "sm:border-l sm:pl-6",
                            index % 3 === 0
                                ? "lg:border-l-0 lg:pl-0"
                                : "lg:border-l lg:pl-8 2xl:pl-10",
                        ]}
                    >
                        <dt class="plate text-2xs text-steel-400">
                            {item.label}
                        </dt>
                        <dd class="font-oswald text-lg uppercase tracking-[0.02em] text-steel-900 2xl:text-xl">
                            {item.value}
                        </dd>
                    </div>
                ))
            }
        </dl>

        <div
            class="mt-14 flex max-w-measure flex-col gap-5 text-base leading-relaxed lg:mt-16 lg:text-lg"
        >
            {
                paragraphs.map((p, index) => (
                    <p
                        data-reveal="fade-up"
                        data-reveal-delay={index * 80}
                        class="leading-7"
                    >
                        {p}
                    </p>
                ))
            }
        </div>
    </Container>
</section>
