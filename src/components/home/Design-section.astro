---
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { shortFlow } from "../../data/design-flow.js";
import ProcessRow from "../common/Process-row.astro";
---

<!-- La lista cierra con una regla, así que abajo va menos aire que arriba. -->
<section class="bg-steel-900 pb-14 pt-20 lg:pb-20 lg:pt-28 2xl:pb-24 2xl:pt-32">
    <Container>
        <!-- Es la única sección de fondo oscuro que usa SectionTitle: sin
             `inverse` el h2 sale steel-900 sobre steel-900, o sea invisible. -->
        <SectionTitle
            label="Del estudio inicial a la puesta en marcha"
            kicker="Qué hacemos"
            subtitle="Diseño y fabricación a medida, con montaje y asistencia coordinados según el proyecto y su ubicación."
            variant="inverse"
            align="start"
            class="lg:max-w-[48rem]"
        />

        <!-- Filas, no columnas: la secuencia se lee hacia abajo, como el trabajo.
             `role="list"` porque el reset de Tailwind quita el marcador y Safari
             deja de anunciar la lista cuando eso pasa. -->
        <ol role="list" class="mt-10 border-t border-white/15 lg:mt-12">
            {
                shortFlow.map((item, index) => (
                    <ProcessRow
                        step={String(index + 1).padStart(2, "0")}
                        title={item.title}
                        description={item.description}
                        deliverable={item.deliverable}
                        index={index}
                    />
                ))
            }
        </ol>

        <!-- La cadena termina en la acción, no en un botón suelto arriba.
             El rótulo va en blanco: el naranja señaliza con la flecha, no con
             un titular de 25px, que era el único bloque de texto grande en
             naranja del home. -->
        <a
            href="/design"
            class="group flex items-center justify-between gap-6 border-b border-white/15 py-6 no-underline transition-colors duration-200 ease-out hover:no-underline lg:py-7"
        >
            <span
                class="font-oswald text-lg uppercase tracking-[0.12em] text-white transition-colors duration-200 group-hover:text-accent-400 lg:text-xl"
            >
                Ver el proceso completo
            </span>
            <svg
                viewBox="0 0 24 24"
                class="h-5 w-5 shrink-0 text-accent-500 transition-transform duration-200 ease-out group-hover:translate-x-1.5 lg:h-6 lg:w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
            >
                <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="square"></path>
            </svg>
        </a>
    </Container>
</section>
