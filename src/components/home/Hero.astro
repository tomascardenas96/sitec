---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/f5d41eb7-25c9-48a8-8e4f-95947947fa13.png";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { phone, encoded } from "../../data/whatsapp.js";

// Datos de chapa: cada uno sale de contenido que ya existía en el sitio.
const plate = [
    { value: "+15 años", label: "Experiencia técnica del equipo" },
    { value: "Fabricación a medida", label: "Potencia y control" },
    { value: "Diseño · Fabricación · Montaje", label: "Según el alcance acordado" },
    { value: "Tandil, Bs. As.", label: "Base de operaciones" },
];
---

<section class="relative flex min-h-[38rem] flex-col justify-end overflow-hidden bg-steel-950 lg:min-h-[30rem] 2xl:min-h-[35rem] text-white">
    <Image
        src={heroImage}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={68}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-center brightness-100"
    />
    <!-- Doble velo: el texto vive sobre acero sólido, la foto respira a la derecha. -->
    <div
        class="absolute inset-0 bg-gradient-to-r from-steel-950 via-steel-950/85 to-steel-950/55"
        aria-hidden="true"
    ></div>
    <div
        class="absolute inset-0 bg-gradient-to-t from-steel-950/90 via-steel-950/10 to-steel-950/45"
        aria-hidden="true"
    ></div>

    <Container class="relative z-10 flex flex-1 items-center py-16 lg:py-0">
        <div class="w-full max-w-[46rem]">
            <div class="flex items-center gap-4 animate-plate-in motion-reduce:animate-none">
                <span class="h-[3px] w-12 bg-accent-500"></span>
                <p class="plate text-2xs text-accent-400 2xl:text-xs">
                    Tableros eléctricos industriales
                </p>
            </div>

            <h1
                class="mt-7 max-w-[19ch] !leading-[3.6rem] font-oswald text-4xl/none sm:text-3xl/none lg:text-4xl/none xl:text-5xl/none font-medium uppercase tracking-display animate-plate-in motion-reduce:animate-none"
                style="animation-delay: 90ms"
            >
                Soluciones eléctricas integrales y montajes industriales
            </h1>

            <!-- <p
                class="mt-7 max-w-measure text-base leading-relaxed text-steel-200 animate-plate-in motion-reduce:animate-none lg:text-lg"
                style="animation-delay: 180ms"
            >
                Fabricamos tableros de distribución, comando y automatización, y
                ejecutamos el montaje electromecánico y la puesta en marcha en
                obra.
            </p> -->

            <div
                class="mt-10 flex flex-col gap-3 animate-plate-in motion-reduce:animate-none sm:flex-row sm:gap-4"
                style="animation-delay: 270ms"
            >
                <Button
                    href={`https://wa.me/${phone}?text=${encoded}`}
                    target="_blank"
                    variant="primary"
                    size="lg"
                >
                    Solicitar presupuesto
                </Button>
                <Button href="/projects" variant="outlineLight" size="lg">
                    Ver proyectos
                </Button>
            </div>
        </div>
    </Container>

    <!-- Chapa de datos al pie del gabinete. -->
    <div class="relative z-10 border-t border-white/20 bg-steel-950/70">
        <Container>
            <dl class="grid grid-cols-1 lg:grid-cols-4">
                {plate.map((item, index) => (
                    <div
                        class:list={[
                            "py-5 lg:py-6",
                            index > 0 &&
                                "border-t border-white/15 lg:border-t-0",
                            index > 0 &&
                                "lg:border-l lg:border-white/15 lg:pl-6 xl:pl-8",
                        ]}
                    >
                        <dt class="font-oswald text-base uppercase tracking-[0.04em] lg:text-lg">
                            {item.value}
                        </dt>
                        <dd class="plate mt-1.5 text-2xs text-accent-400">
                            {item.label}
                        </dd>
                    </div>
                ))}
            </dl>
        </Container>
    </div>
</section>
