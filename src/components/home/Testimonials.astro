---
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { testimonials } from "../../data/testimonials";
import Testimonial from "./Testimonial.card.astro";
---

{
  testimonials.length > 0 && (
    <section class="bg-steel-50 py-20 lg:py-28 2xl:py-32">
      <Container>
        <SectionTitle
          label="Lo que dicen los clientes"
          kicker="Referencias"
          align="start"
          class="lg:max-w-[38rem]"
        />

        <div class="mt-12 grid border-t border-steel-200 lg:mt-16 lg:grid-cols-3">
          {testimonials.map((testimonial, index) => (
            <Testimonial
              name={testimonial.name}
              role={testimonial.role}
              company={testimonial.company}
              body={testimonial.body}
              index={index}
            />
          ))}
        </div>
      </Container>
    </section>
  )
}
