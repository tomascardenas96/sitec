---
interface Props {
  question: string;
  answer: string;
  index?: number;
}

const { question, answer, index = 0 } = Astro.props;
---

<details
  class="group border-b border-steel-200"
  data-reveal="fade-up"
  data-reveal-delay={Math.min(index, 3) * 70}
>
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 lg:py-7"
  >
    <h3
      class="font-oswald text-lg font-medium uppercase tracking-display text-steel-900 transition-colors duration-200 group-hover:text-accent-700 group-open:text-accent-700 2xl:text-xl"
    >
      {question}
    </h3>

    <span class="relative size-6 shrink-0" aria-hidden="true">
      <span
        class="absolute left-1/2 top-1/2 h-[2px] w-4 -translate-x-1/2 -translate-y-1/2 bg-steel-900 transition-colors duration-200 group-open:bg-accent-600"
      ></span>
      <span
        class="absolute left-1/2 top-1/2 h-4 w-[2px] -translate-x-1/2 -translate-y-1/2 bg-steel-900 transition-transform duration-300 ease-out group-open:scale-y-0"
      ></span>
    </span>
  </summary>

  <p class="max-w-measure pb-8 text-base leading-relaxed text-steel-500">
    {answer}
  </p>
</details>
