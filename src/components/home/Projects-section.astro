---
import { allProjects } from "../../data/projects.js";
import ProjectCard from "../common/Project-card.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";

// Keep a focused home preview; the complete selection lives at /projects.
const featured = allProjects.slice(0, 3);
---

<section class="py-20 lg:py-28 2xl:py-32">
  <Container>
    <div
      class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-16"
    >
      <SectionTitle
        label="Obras realizadas"
        kicker="Proyectos"
        subtitle="Tableros y sistemas de control fabricados, montados y puestos en marcha por el equipo."
        align="start"
        class="lg:max-w-[38rem]"
      />

      <div class="shrink-0">
        <Button href="/projects" variant="outline">Ver todas las obras</Button>
      </div>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 2xl:gap-8">
      {
        featured.map((project, index) => (
          <ProjectCard
            image={project.image}
            title={project.title}
            subtitle={project.subtitle}
            id={project.id}
            index={index}
          />
        ))
      }
    </div>
  </Container>
</section>
