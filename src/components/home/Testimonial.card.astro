---
interface Props {
  name: string;
  role?: string;
  company?: string;
  body: string;
  index?: number;
}

const { name, role, company, body, index = 0 } = Astro.props;
---

<figure
  class:list={[
    "m-0 border-b border-steel-200 py-9 lg:border-b-0 lg:py-10",
    index > 0 && "lg:border-l lg:border-steel-200 lg:pl-8 2xl:pl-10",
    index < 2 && "lg:pr-8 2xl:pr-10",
  ]}
  data-reveal="fade-up"
  data-reveal-delay={index * 90}
>
  <span class="block h-[3px] w-8 bg-accent-500" aria-hidden="true"></span>

  <blockquote
    class="mt-6 text-base leading-relaxed text-steel-700 lg:text-lg lg:leading-[1.75]"
  >
    {body}
  </blockquote>

  <figcaption class="mt-7">
    <p
      class="font-oswald text-sm font-medium uppercase tracking-[0.1em] text-steel-900"
    >
      {name}
    </p>
    {
      (role || company) && (
        <p class="plate mt-1.5 text-2xs text-steel-400">
          {[role, company].filter(Boolean).join(" · ")}
        </p>
      )
    }
  </figcaption>
</figure>
