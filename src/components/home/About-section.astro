---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { allProjects } from "../../data/projects.js";
import { components } from "../../data/components.js";
import { glyphs } from "../../data/glyphs.js";

// La foto no decora: es una obra del catálogo y se identifica como tal.
const featured = allProjects[0];
const span = "font-semibold text-steel-900";
---

<section class="py-20 lg:py-28 2xl:py-32">
  <Container>
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16 2xl:gap-24">
      <div>
        <SectionTitle
          label="Energía que inspira confianza"
          kicker="Quiénes somos"
          align="start"
        />

        <div class="mt-8 flex flex-col gap-5 text-base leading-relaxed lg:text-lg">
          <p class="max-w-measure" data-reveal="fade-up">
            En <span class={span}>BALCA</span> nos especializamos en la fabricación
            y el diseño de tableros de potencia y control, ofreciendo soluciones
            <span class={span}>seguras</span>, <span class={span}
              >eficientes</span
            > y <span class={span}>adaptadas</span> a cada necesidad.
          </p>
          <p class="max-w-measure" data-reveal="fade-up" data-reveal-delay="80">
            Atendemos empresas y particulares. Nuestra experiencia está en el
            sector agroindustrial, las instalaciones eléctricas para bombas y
            el montaje electromecánico.
          </p>
        </div>

        <!-- Qué sale del taller: lista de tipos, con la misma grilla de reglas. -->
        <h3 class="plate mt-10 text-2xs text-steel-400">Qué fabricamos</h3>
        <ul
          class="mt-4 grid border-t border-steel-200 sm:grid-cols-2 sm:gap-x-8"
          data-reveal="fade-up"
          data-reveal-delay="140"
        >
          {
            components.map((item) => (
              <li class="flex items-center gap-3 border-b border-steel-200 py-3 font-oswald text-sm uppercase tracking-[0.08em] text-steel-900">
                <svg
                  viewBox="0 0 24 24"
                  class="h-4 w-4 shrink-0 text-accent-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  {glyphs[item.glyph].map((d) => (
                    <path d={d} />
                  ))}
                </svg>
                {item.title}
              </li>
            ))
          }
        </ul>

        <div class="mt-10">
          <Button href="/about-us" variant="outline">Conocé la empresa</Button>
        </div>
      </div>

      <figure
        class="relative m-0 w-full lg:max-w-[30rem] lg:justify-self-end"
        data-reveal="fade-up"
        data-reveal-delay="120"
      >
        <!-- Escuadra de señalización: ancla la foto a la grilla en lugar de flotarla. -->
        <span
          class="absolute -left-3 -top-3 hidden h-16 w-[3px] bg-accent-500 lg:block"
          aria-hidden="true"></span>
        <span
          class="absolute -left-3 -top-3 hidden h-[3px] w-16 bg-accent-500 lg:block"
          aria-hidden="true"></span>

        <Image
          src={featured.image}
          alt={`${featured.title}: ${featured.subtitle}`}
          width={640}
          densities={[1, 2]}
          format="webp"
          quality={72}
          loading="lazy"
          class="aspect-[4/5] w-full object-cover"
        />

        <figcaption
          class="flex items-baseline justify-between gap-4 border-t-2 border-steel-900 bg-white pt-3"
        >
          <span class="font-oswald text-sm uppercase tracking-[0.08em] text-steel-900">
            {featured.title}
          </span>
          <span class="plate shrink-0 text-2xs text-steel-400">Obra ejecutada</span>
        </figcaption>
      </figure>
    </div>
  </Container>
</section>
