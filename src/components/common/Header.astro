---
import HeaderList from "./Header-list.astro";
import MobileMenu from "./Mobile-menu.astro";
import SocialLinks from "./Social-links.astro";
import { phone, encoded } from "../../data/whatsapp.js";
---

<header
    id="site-header"
    data-scrolled="false"
    class="sticky top-0 z-40 border-b border-steel-200 bg-white transition-shadow duration-300 ease-out data-[scrolled=true]:shadow-elevated"
>
    <div
        class="mx-auto flex w-full max-w-shell items-stretch justify-between px-5 sm:px-8 lg:px-10 2xl:px-16"
    >
        <a
            href="/"
            class="flex shrink-0 items-center py-3 no-underline hover:no-underline"
            aria-label="BALCA — Inicio"
        >
            <img
                src="/balca-logo.svg"
                alt="BALCA, instalaciones eléctricas integrales y montajes industriales"
                width="1000"
                height="400"
                decoding="async"
                class="h-12 w-auto lg:h-14 2xl:h-16"
            />
        </a>

        <div class="flex items-stretch">
            <nav
                aria-label="Navegación principal"
                class="hidden items-center gap-8 pr-8 lg:flex xl:gap-10 xl:pr-10"
            >
                <HeaderList />
                <span class="h-5 w-px bg-steel-200"></span>
                <SocialLinks />
            </nav>

            <!-- Bloque de acción a sangre: la pieza naranja cierra la barra. -->
            <a
                href={`https://wa.me/${phone}?text=${encoded}`}
                target="_blank"
                rel="noopener noreferrer"
                class="hidden self-center h-14 items-center bg-accent-600 px-7 font-oswald text-xs uppercase tracking-[0.16em] font-medium text-white no-underline transition-colors duration-200 ease-out hover:bg-accent-400 hover:no-underline md:flex 2xl:px-9 2xl:text-sm"
            >
                Solicitar presupuesto
            </a>

            <button
                id="burger"
                type="button"
                aria-label="Abrir menú"
                aria-controls="menu"
                aria-expanded="false"
                class="flex w-16 items-center justify-center border-l border-steel-200 text-steel-900 transition-colors duration-200 hover:bg-steel-900 hover:text-white lg:hidden"
            >
                <svg
                    viewBox="0 0 24 24"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="square"
                    ></path>
                </svg>
            </button>
        </div>
    </div>

    <MobileMenu />
</header>

<script is:inline>
    (() => {
        const header = document.getElementById("site-header");
        if (!header) return;
        const update = () => {
            header.dataset.scrolled = window.scrollY > 24 ? "true" : "false";
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
    })();
</script>
