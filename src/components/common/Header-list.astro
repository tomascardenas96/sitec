---
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/about-us", label: "Sobre Nosotros" },
  { href: "/design", label: "Diseño" },
  { href: "/projects", label: "Proyectos" },
  { href: "/contact", label: "Contacto" },
];

const isActive = (href) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<ul class="flex items-center gap-6 xl:gap-8">
  {
    links.map((link) => {
      const active = isActive(link.href);
      return (
        <li>
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class={`group relative block py-2 font-oswald text-sm uppercase tracking-[0.1em] no-underline transition-colors duration-200 hover:no-underline 2xl:text-base ${
              active
                ? "text-steel-900"
                : "text-steel-500 hover:text-steel-900"
            }`}
          >
            {link.label}
            <span
              class={`absolute bottom-0 left-0 h-[3px] w-full origin-left bg-accent-500 transition-transform duration-200 ease-out group-hover:scale-x-100 ${
                active ? "scale-x-100" : "scale-x-0"
              }`}
              aria-hidden="true"
            />
          </a>
        </li>
      );
    })
  }
</ul>
