---
import Container from "../ui/Container.astro";

import { phones } from "../../data/contact.js";
---

<div class="text-steel-200 bg-gradient-to-t from-[#1D5D5F] to-[#27777A]">
    <Container class="flex h-9 items-center justify-between gap-4">
        <p class="plate text-2xs text-white truncate">
            Energía segura, proyectos confiables
        </p>

        <div class="flex items-center gap-4 shrink-0">
            <span class="plate hidden text-2xs text-white sm:inline">
                Tandil, Bs. As.
            </span>
            <span class="hidden h-3 w-px bg-white sm:inline-block"></span>
            <ul class="flex gap-3">
                {
                    phones.map((p) => (
                        <li class="flex">
                            <a
                                href={p.href}
                                class="font-oswald text-2xs text-white no-underline transition-colors duration-200 hover:text-accent-400 hover:no-underline"
                            >
                                {p.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </Container>
</div>
