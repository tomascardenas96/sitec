---
import Container from "../ui/Container.astro";
import SocialLinks from "./Social-links.astro";
import { phone, encoded } from "../../data/whatsapp.js";

const year = new Date().getFullYear();

const sections = [
  { href: "/", label: "Inicio" },
  { href: "/about-us", label: "Sobre Nosotros" },
  { href: "/design", label: "Diseño" },
  { href: "/projects", label: "Proyectos" },
  { href: "/contact", label: "Contacto" },
];

const phones = [
  { label: "(2494) - 123456", href: "tel:+542494123456" },
  { label: "(2494) - 789987", href: "tel:+542494789987" },
];
---

<footer class="bg-steel-950 text-steel-200">
  <!-- Franja de señalización: el mismo motivo que cierra el bloque de contacto. -->
  <div class="hazard h-2" aria-hidden="true"></div>

  <Container class="py-14 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-16">
      <div class="flex flex-col items-start gap-6">
        <!-- Chapa de identificación: el logo vive sobre su placa, como en el gabinete. -->
        <div class="bg-white px-5 py-4">
          <img
            src="/balca-logo.svg"
            alt="BALCA, instalaciones eléctricas integrales y montajes industriales"
            width="1000"
            height="400"
            loading="lazy"
            decoding="async"
            class="h-11 w-auto"
          />
        </div>

        <p class="max-w-[46ch] text-sm leading-relaxed text-steel-300">
          Soluciones eléctricas y electromecánicas de calidad, desde el diseño
          hasta el montaje y puesta en marcha de tableros. Trabajamos bajo todas
          las normas de seguridad vigentes.
        </p>

        <SocialLinks variant="dark" />
      </div>

      <nav aria-labelledby="footer-secciones">
        <h2 id="footer-secciones" class="plate mb-6 text-2xs text-accent-400">
          Secciones
        </h2>
        <ul class="flex flex-col">
          {
            sections.map((section) => (
              <li class="border-b border-steel-800">
                <a
                  href={section.href}
                  class="block py-3 font-oswald text-sm uppercase tracking-[0.1em] text-steel-200 no-underline transition-colors duration-200 hover:text-accent-400 hover:no-underline"
                >
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="plate mb-6 text-2xs text-accent-400">Contacto</h2>

        <dl class="flex flex-col gap-5 text-sm">
          <div>
            <dt class="plate text-2xs text-steel-300">Taller</dt>
            <dd class="mt-1 leading-relaxed text-steel-200">
              Figueroa 2367<br />Tandil, Buenos Aires
            </dd>
          </div>
          <div>
            <dt class="plate text-2xs text-steel-300">Teléfonos</dt>
            <dd class="mt-1 flex flex-col gap-1">
              {
                phones.map((p) => (
                  <a
                    href={p.href}
                    class="text-steel-200 no-underline transition-colors duration-200 hover:text-accent-400"
                  >
                    {p.label}
                  </a>
                ))
              }
            </dd>
          </div>
        </dl>

        <a
          href={`https://wa.me/${phone}?text=${encoded}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex h-12 items-center border-2 border-steel-700 px-6 font-oswald text-xs uppercase tracking-[0.16em] text-white no-underline transition-colors duration-200 ease-out hover:border-accent-500 hover:bg-accent-500 hover:text-steel-950 hover:no-underline"
        >
          Pedir presupuesto
        </a>
      </div>
    </div>
  </Container>

  <div class="border-t border-steel-800">
    <Container
      class="flex flex-col gap-2 py-6 text-2xs text-steel-300 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} BALCA — Todos los derechos reservados</p>
      <p>
        Sitio por <a
          href="https://www.tomascardenas.me"
          target="_blank"
          rel="noopener noreferrer"
          class="text-steel-300 no-underline transition-colors duration-200 hover:text-accent-400"
          >Tomás Cárdenas</a
        >
      </p>
    </Container>
  </div>
</footer>
