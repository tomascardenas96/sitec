---
import { Image } from "astro:assets";
import HeroImage from "../../assets/images/f5d41eb7-25c9-48a8-8e4f-95947947fa13.png";
import Container from "../ui/Container.astro";

interface Props {
    title: string;
    kicker?: string;
    subtitle?: string;
}

const { title, kicker = "BALCA", subtitle } = Astro.props;
---

<section
    class="relative flex min-h-[16rem] items-end overflow-hidden bg-steel-950 lg:min-h-[20rem]"
>
    <Image
        src={HeroImage}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={68}
        loading="eager"
        class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div
        class="absolute inset-0 bg-gradient-to-r from-steel-950 via-steel-950/80 to-steel-950/30"
        aria-hidden="true"
    >
    </div>

    <Container class="relative z-10 py-10 lg:py-14">
        <div
            class="flex items-center gap-4 animate-plate-in motion-reduce:animate-none"
        >
            <span class="h-[3px] w-10 bg-accent-500"></span>
            <p class="plate text-2xs text-accent-400">{kicker}</p>
        </div>
        <h1
            class="mt-5 font-oswald text-4xl font-medium uppercase tracking-display text-white animate-plate-in motion-reduce:animate-none lg:text-6xl"
            style="animation-delay: 90ms"
        >
            {title}
        </h1>
        {
            subtitle && (
                <p
                    class="mt-4 max-w-measure text-base leading-relaxed text-steel-200 animate-plate-in motion-reduce:animate-none lg:text-lg"
                    style="animation-delay: 180ms"
                >
                    {subtitle}
                </p>
            )
        }
    </Container>
</section>
