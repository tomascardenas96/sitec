---
import { Image } from "astro:assets";
import MainLayout from "../../../layouts/Main-layout.astro";
import Container from "../../../components/ui/Container.astro";
import CtaSection from "../../../components/common/Cta-section.astro";
import { allProjects } from "../../../data/projects.js";

export async function getStaticPaths() {
    return allProjects.map((project) => ({
        params: { id: project.id.toString() },
    }));
}

const { id } = Astro.params;
const index = allProjects.findIndex((p) => p.id.toString() === id);
const project = allProjects[index];
const ref = String(project.id).padStart(2, "0");
const prev = index > 0 ? allProjects[index - 1] : null;
const next = index < allProjects.length - 1 ? allProjects[index + 1] : null;
---

<MainLayout
    title={`${project.title} — Obra N.º ${ref} | BALCA`}
    description={project.subtitle}
>
    <section class="bg-steel-950 py-14 lg:py-20">
        <Container>
            <a
                href="/projects"
                class="group inline-flex items-center gap-2 no-underline hover:no-underline"
            >
                <svg
                    viewBox="0 0 24 24"
                    class="h-3.5 w-3.5 shrink-0 text-accent-500 transition-transform duration-200 ease-out group-hover:-translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                >
                    <path d="M20 12H5M11 18l-6-6 6-6" stroke-linecap="square"
                    ></path>
                </svg>
                <span
                    class="plate text-2xs text-accent-400 transition-colors duration-200 group-hover:text-accent-300"
                >
                    Volver al registro
                </span>
            </a>

            <p class="plate mt-8 text-2xs text-steel-300">Obra N.º {ref}</p>
            <h1
                class="mt-4 max-w-[24ch] font-oswald text-4xl font-medium uppercase tracking-display text-white lg:text-6xl"
            >
                {project.title}
            </h1>
            <p
                class="mt-4 max-w-measure text-base leading-relaxed text-steel-200 lg:text-lg"
            >
                {project.subtitle}
            </p>
        </Container>
    </section>

    <section class="py-16 lg:py-20 2xl:py-24">
        <Container>
            <div
                class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start lg:gap-16 2xl:gap-20"
            >
                <figure class="relative m-0 w-full" data-reveal="fade-up">
                    <span
                        class="absolute -left-3 -top-3 hidden h-16 w-[3px] bg-accent-500 lg:block"
                        aria-hidden="true"></span>
                    <span
                        class="absolute -left-3 -top-3 hidden h-[3px] w-16 bg-accent-500 lg:block"
                        aria-hidden="true"></span>

                    <Image
                        src={project.image}
                        alt={project.title}
                        widths={[768, 1280]}
                        sizes="(min-width: 1024px) 55vw, 100vw"
                        format="webp"
                        quality={72}
                        loading="eager"
                        class="aspect-[4/3] w-full object-cover"
                    />
                </figure>

                <div data-reveal="fade-up" data-reveal-delay="80">
                    <p class="plate text-2xs text-steel-400">Descripción</p>
                    <p
                        class="mt-4 max-w-measure text-base leading-8 text-steel-700 lg:text-lg lg:leading-7"
                    >
                        {project.description}
                    </p>
                </div>
            </div>

            <div
                class="mt-16 grid border-y border-steel-200 sm:grid-cols-2 lg:mt-20"
            >
                {
                    prev ? (
                        <a
                            href={`/projects/preview/${prev.id}`}
                            class="group flex items-center gap-4 py-6 no-underline transition-colors duration-200 ease-out hover:no-underline sm:pr-8"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                class="h-5 w-5 shrink-0 text-accent-500 transition-transform duration-200 ease-out group-hover:-translate-x-1.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                aria-hidden="true"
                            >
                                <path
                                    d="M20 12H5M11 18l-6-6 6-6"
                                    stroke-linecap="square"
                                />
                            </svg>
                            <div>
                                <p class="plate text-2xs text-steel-400">
                                    Obra anterior
                                </p>
                                <p class="mt-1 font-oswald text-base uppercase tracking-display text-steel-900 transition-colors duration-200 group-hover:text-accent-700">
                                    {prev.title}
                                </p>
                            </div>
                        </a>
                    ) : (
                        <div aria-hidden="true" />
                    )
                }
                {
                    next ? (
                        <a
                            href={`/projects/preview/${next.id}`}
                            class="group flex items-center justify-end gap-4 border-t border-steel-200 py-6 text-right no-underline transition-colors duration-200 ease-out hover:no-underline sm:border-l sm:border-t-0 sm:pl-8"
                        >
                            <div>
                                <p class="plate text-2xs text-steel-400">
                                    Obra siguiente
                                </p>
                                <p class="mt-1 font-oswald text-base uppercase tracking-display text-steel-900 transition-colors duration-200 group-hover:text-accent-700">
                                    {next.title}
                                </p>
                            </div>
                            <svg
                                viewBox="0 0 24 24"
                                class="h-5 w-5 shrink-0 text-accent-500 transition-transform duration-200 ease-out group-hover:translate-x-1.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                aria-hidden="true"
                            >
                                <path
                                    d="M4 12h15M13 6l6 6-6 6"
                                    stroke-linecap="square"
                                />
                            </svg>
                        </a>
                    ) : (
                        <div
                            aria-hidden="true"
                            class="border-t border-steel-200 sm:border-t-0"
                        />
                    )
                }
            </div>
        </Container>
    </section>

    <CtaSection />
</MainLayout>
